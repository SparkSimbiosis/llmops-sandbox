# образ сервісу sandbox: Python 3.12 + FastAPI; digest закріплено, щоб збірка образу була відтворюваною
FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY sandbox/ ./sandbox/
EXPOSE 8080
# один процес uvicorn без --workers: кеш, лічильники й черги живуть у пам'яті процесу
CMD ["uvicorn", "sandbox.main:app", "--host", "0.0.0.0", "--port", "8080"]
