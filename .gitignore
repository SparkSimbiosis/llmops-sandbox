# .vscode/* , а не .vscode/ — git не заходить усередину ігнорованої теки,
# і виняток нижче просто не розглядався б
.vscode/*
# спільні налаштування проєкту лишаємо: вони стосуються всіх, хто відкриє
# стартер, а не чиїхось особистих звичок
!.vscode/settings.json
real.local.yml

